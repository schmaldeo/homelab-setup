---
services:
  wg-easy:
    image: "{{ wg_easy_image }}"
    container_name: wg-easy
    volumes:
      - "./data:/etc/wireguard"
      - "/lib/modules:/lib/modules:ro"
    ports:
      - "{{ wg_easy_wireguard_port }}:51820/udp"
    environment:
      WG_HOST: "{{ wg_easy_host }}"
      PORT: "80"
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      net.ipv4.ip_forward: "1"
      net.ipv4.conf.all.src_valid_mark: "1"
      net.ipv6.conf.all.disable_ipv6: "0"
      net.ipv6.conf.all.forwarding: "1"
      net.ipv6.conf.default.forwarding: "1"
    networks:
      - wg_easy

  caddy:
    image: "{{ wg_easy_caddy_image }}"
    container_name: wg-easy-caddy
    ports:
      - "{{ wg_easy_host }}:{{ wg_easy_panel_port }}:443/tcp"
    volumes:
      - "./Caddyfile:/etc/caddy/Caddyfile:ro"
      - "./caddy/data:/data"
      - "./caddy/config:/config"
    restart: unless-stopped
    networks:
      - wg_easy

networks:
  wg_easy:
    name: wg-easy
